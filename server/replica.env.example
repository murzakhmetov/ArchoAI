# Replication between this Pi and the Supabase cloud project (server/replicate.py).
# Copy to server/replica.env (git-ignored) to switch it on. Never put these values in archoai_app/.env.

# Address of the cloud project and its SECRET key (Dashboard > Project Settings > API Keys).
REPLICA_URL=https://<project ref>.supabase.co
REPLICA_SECRET_KEY=

# Address that phones use for this Pi (the one in SUPABASE_URL of archoai_app/.env). Written into the photo
# and model links of artifacts copied to the Pi. Optional when the Pi already has artifacts.
REPLICA_LOCAL_PUBLIC_URL=http://192.168.1.61:54321

# Optional: where the replicator keeps its watermarks. Default: $STATE_DIRECTORY/replica_state.json under
# systemd, /var/lib/archoai/replica_state.json for a manual run when that folder exists and is writable
# (so manual runs and the timer share one state and one lock), else server/.replica_state.json.
# Never point it into the repository for the service: the unit makes the repository read-only.
# REPLICA_STATE_FILE=
