# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored but is declared as a Flutter asset, so the app and
# `flutter test` need the file to exist. Values in `.env` are bundled into the
# app binary, so anyone who has the app can extract them. A Supabase publishable
# key is meant for that; the Gemini and Tripo keys are secret and billable: use
# keys with spending limits for demos and move those calls behind a backend
# before a public release.

# --- Supabase ---------------------------------------------------------------
# One set of names works for the app AND the Python scripts in ../scripts
# (they read this file too).
#   app:                 SUPABASE_URL (or SUPABASE_PROJECT_REF) + a key
#   withbutton*.py:      SUPABASE_PROJECT_REF + SUPABASE_KEY
#   generate_smooth_data.py: SUPABASE_URL + SUPABASE_SERVICE_KEY (a secret key: set it in your SHELL,
#                            never in this file, because this file is bundled into the app)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# Publishable (anon) key. The app also accepts SUPABASE_PUBLISHABLE_KEY or
# SUPABASE_ANON_KEY instead of SUPABASE_KEY.
SUPABASE_KEY=

# --- Gemini (artifact analysis + chat) --------------------------------------
GEMINI_API_KEY=

# --- Python scripts in ../scripts/scripts (all optional) --------------------
# GEMINI_MODEL=gemini-3.1-flash-lite
# SUPABASE_BUCKET_NAME=artifact-images
# SUPABASE_MODEL_BUCKET_NAME=3d1
# true (default): copy the generated GLB into Supabase Storage (permanent link).
# false: store the temporary Tripo link in the database instead.
# UPLOAD_GLB_TO_SUPABASE=true

# --- Tripo 3D generation (API v3) -------------------------------------------
TRIPO_API_KEY=
# Optional. Default is v3.1-20260211. Other values: v3.0-20250812, v2.5-20250123.
# TRIPO_MODEL=v3.1-20260211
# Optional polycount cap (positive integer). Lower = smaller GLB, faster viewer.
# TRIPO_FACE_LIMIT=100000
# Tripo accounts belong to one region and are never switched automatically:
# a key created on tripo3d.ai only works on the global host, a key created on
# tripo3d.com only on the China host.
# TRIPO_REGION=global          # or: china
# Optional full base URL override, wins over TRIPO_REGION.
# TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
